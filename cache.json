    {
      "title": "UniFi Access Point | Releases | Ubiquiti Community",
      "feedUrl": "https://community.ui.com/rss/releases/UniFi-Access-Point-Switch/9fc3b2fa-9e73-449a-924f-470e79884470",
      "siteUrl": "https://community.ui.com",
      "articles": [
        {
          "id": "e2aa5440-1995-4ef5-b5ef-7706d8e39b61",
          "author": "UI-liusats",
          "description": "Improvements\n\nImproved 2.4 GHz band connectivity and stability.\nImproved 5 GHz auto-channel selection.\nImproved Packet Capture feature.\nImproved TX Retries reporting.\nImproved connectivity at low signal levels.\nImproved stability.\n\nBugfixes\n\nFixed various mobile device 6 GHz connectivity issues.\nFixed incorrectly reported disconnect events during client roam.\nFixed AP going offline when the Network application is unreachable for some time.\n\nAdditional information\nPlease note that this firmware is not available for U7 Pro Max. We are actively working on adapting recent improvements for the U7 Pro Max and anticipate its release at a later date.\n\n\nTo update your devices, set the Device Firmware Release Channel in the UniFi Network application to Official.\n\n\nIf you encounter any issues with this release, please provide us with some details on your setup and include the below information:\n\nAP model(s)\nPrevious AP release version\nUniFi Network application version\nPlease post a support file as well",
          "link": "https://community.ui.com/releases/UniFi-Access-Point-7-0-95/e2aa5440-1995-4ef5-b5ef-7706d8e39b61",
          "publishedOn": "2024-12-19T10:26:32.000Z",
          "wordCount": 19,
          "title": "UniFi Access Point 7.0.95",
          "imageUrl": null
        },
        {
          "id": "2bf8bcbb-dd43-4bac-865f-e579844c458d",
          "author": "UI-Edmundas",
          "description": "Improvements\n\nImproved 2.4 GHz band connectivity and stability.\nImproved Packet Capture feature.\nImproved TX Retries reporting.\nImproved connectivity at low signal levels.\nImproved stability.\n\nBugfixes\n\nFixed various mobile device 6 GHz connectivity issues.\nFixed incorrectly reported disconnect events during client roam.\nFixed AP going offline when the Network application is unreachable for some time.\n\nAdditional information\nPlease note that this firmware is not available for U7 Pro Max. We are actively working on adapting recent improvements for the U7 Pro Max and anticipate its release at a later date.\n\n\nUpdate your devices by changing the Device Firmware Release Channel in the UniFi Network application to Official.\nIf you wish to go back to the Official release after the upgrade, change the release channel back to Official.\n\n\nIf you encounter any issues with this release, please provide us with some details on your setup and include the below information:\n\nAP model(s)\nPrevious AP release version\nUniFi Network application version\nPlease post a support file as well",
          "link": "https://community.ui.com/releases/UniFi-Access-Point-7-0-92/2bf8bcbb-dd43-4bac-865f-e579844c458d",
          "publishedOn": "2024-12-13T19:44:13.000Z",
          "wordCount": 19,
          "title": "UniFi Access Point 7.0.92",
          "imageUrl": null
        }
      ]
    },
