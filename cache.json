        {
          "id": "39844c4e-748a-4556-af35-19945b06b064",
          "author": "UI-Edmundas",
          "description": "Overview\nThis is the initial release for the U7-LR model.\nAdditional information\nIf you encounter any issues with this release, please provide us with some details on your setup and include the below information:\n\nAP model(s)\nUniFi Network application version",
          "link": "https://community.ui.com/releases/UniFi-Access-Point-U7-LR-8-0-35/39844c4e-748a-4556-af35-19945b06b064",
          "publishedOn": "2025-05-14T18:30:37.000Z",
          "wordCount": 6,
          "title": "UniFi Access Point (U7-LR) 8.0.35",
          "imageUrl": null
        },
        {
          "id": "fc1e206a-3494-4501-aeff-9a92cdd42fab",
          "author": "UI-Edmundas",
          "description": "Overview\nThis is the initial release for the U7-Pro-Outdoor-US model.\nAdditional information\nNOTE: The latest Network EA version 9.2.79 (or later) should be used for the best 6 GHz AFC setup experience. 6 GHz operation is supported in these countries. Long-range 6 GHz performance with AFC available in FCC/IC region only.\n———\nIf you encounter any issues with this release, please provide us with some details on your setup and include the below information:\n\nUniFi Network application version\nUniFi Console Support File (as private attachment)",
          "link": "https://community.ui.com/releases/UniFi-Access-Point-U7-Pro-Outdoor-US-8-0-37/fc1e206a-3494-4501-aeff-9a92cdd42fab",
          "publishedOn": "2025-05-13T13:54:05.000Z",
          "wordCount": 6,
          "title": "UniFi Access Point (U7-Pro-Outdoor-US) 8.0.37",
          "imageUrl": null
        }
      ]
    },
